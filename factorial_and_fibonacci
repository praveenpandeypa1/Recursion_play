#include<iostream>
using namespace std;
int fact(int n)
{
    if(n==0)
    {
        return 1;
    }
    return n*fact(n-1);
}
int main()
{
    int n;
    cin>>n;
    cout<<fact(n);
    return 0;
}

// The fibbonacci series of the given no are:
#include<iostream>
using namespace std;
int fibo(int n)
{
    if(n==0||n==1)
    {
        return n;
    }
    return fibo(n-1)+fibo(n-2);
}
int main()
{
    int n;
    cin>>n;
    cout<<" the fibonacci series of the given no"<<fibo(n);
    return 0;
}

