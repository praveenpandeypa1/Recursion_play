class Solution {
public:
    int myAtoi(string str) {
        long long result=0;
        int sign=1;
        int i=0;
        while(i<str.size() && str[i]==' ')
        {
            i++;
        }
        if(i<str.size() &&(str[i]=='+'||str[i]=='-'))
        {
            if(str[i]=='-')
            {
                sign=-1;
            }
            i++;
        }
        while(i<str.size() && isdigit(str[i]))
        {
            result=(result*10)+(str[i]-'0');
            if(sign*result>INT_MAX)
            {
                return INT_MAX;
            }
            else if(sign*result<INT_MIN)
            {
                return INT_MIN;
            }
            i++;
        }
        return sign*result;
    }
};

