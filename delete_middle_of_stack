** Here while deleing the middle of the stack i am taking a temprary stack to store the element of stack means top of element of stack till the middle and and the stack indexing start from top with index start from 0

  := after reaching at middle you will just asssign one variable name middle get the middle ele by assigning middle to st.top because at that time at st.top middle will be there then do the pop operation for that element 

  and after doing these thing you just push all element from temporaray stack back to main stack so this is the suecase and this is the way how you will do these things:


  this is the method of deleting the middle of stack using extra or temporary stack with  extra space and this is one method:

#include<iostream>
#include<stack>
#include<algorithm>
#include<vector>
using namespace std;
void delete_middle(stack<int>&st)
{
    int n=st.size();
    if(st.empty())
    {
        return ;
    }
    stack<int>temp;
    for(int i=0;i<n/2;i++)
    {
        temp.push(st.top());
        st.pop();
    }
st.pop();
    while(!temp.empty())
    {
        st.push(temp.top());
        temp.pop();
    }
    
}
int main()
{
    stack<int>st;
    st.push(1);
    st.push(2);
    st.push(3);
    st.push(4);
    st.push(5);
    delete_middle(st);
    cout<<"the stack element after deleting the middle element are:";
    while(!st.empty())
    {
        cout<<st.top()<<" ";
        st.pop();
    }
    return 0;
}


this method is more optimized than the stack i have used earlier this method will use recursion to solve the question so space complexity will be o(1)
 #include<iostream>
#include<stack>
#include<algorithm>
using namespace std;
void delete_middle_stack(stack<int>&st, int n, int curr)
{
    if(st.empty()||curr==n/2)
    {
        if(!st.empty()) st.pop();
        return ;
    }
    int top=st.top();
    st.pop();
    delete_middle_stack(st,n,curr+1);
    st.push(top);
}
int main()
{
    stack<int>st;
    st.push(1);
    st.push(2);
    st.push(3);
    st.push(4);
    st.push(5);
    delete_middle_stack(st,st.size(),0);
    while(!st.empty())
    {
        cout<<st.top()<<" ";
        st.pop();
    }
    return 0;
}
