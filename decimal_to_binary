#include<iostream>
using namespace std;
int con(int n)
{
    int result=0;
    int place=1;
    while(n>0)
    {
        result+=(n%2)*place;
        n/=2;
        place*=10;
    }
    return result;
}
int main()
{
    int n;
    cin>>n;
    cout<<"the ginary no representation of the given number are:"<<con(n);
    return 0;
}
