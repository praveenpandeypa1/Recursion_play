class Solution {
public:
      int count_ways(vector<int>&nums, int index, int current_sum, int target)
      {
        if(index==nums.size())
        {
            return (current_sum==target) ? 1:0;

        }
        int add=count_ways(nums, index+1, current_sum+nums[index],target);
        int sub=count_ways(nums, index+1, current_sum-nums[index],target);
        return add+sub;
      }
    int findTargetSumWays(vector<int>& nums, int target) {
       return count_ways(nums,0,0,target); 
    }
};

