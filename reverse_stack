#include<iostream>
#include<algorithm>
#include<vector>
#include<stack>
using namespace std;
void insert_at_bottom(stack<int>&st, int value)
{
    if(st.empty())
    {
        st.push(value);
        return ;
    }
    int top=st.top();
    st.pop();
    insert_at_bottom(st,value);
    st.push(top);
}
void rev(stack<int>&st)
{
    if(st.empty())
    {
        return ;
    }
    int top=st.top();
    st.pop();
    rev(st);
    insert_at_bottom(st,top);
}
int main()
{
    stack<int>st;
    st.push(1);
    st.push(2);
    st.push(3);
    st.push(4);
    st.push(5);
    rev(st);
    while(!st.empty())
    {
        cout<<st.top()<<" ";
        st.pop();
    }
    return 0;
}

