class Solution {
public:
    double myPow(double x, int n) {
    double result=1;
    long long N=n;
    if(n==0)
    {
        return 1;
    }
    if(N<0)
    {
        N=-N;
        x=1/x;
    }
    while(N>0)
    {
        if(N%2==1) result*=x;
        x*=x;
        N/=2;
    }
    return result;
    }
};

